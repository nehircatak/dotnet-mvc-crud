@model DotNet.Models.EgitimModel

@{
    ViewData["Title"] = "Ana Sayfa - Eğitim Formu";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4 text-center">📝 Yeni Eğitim Kaydı</h2>

    <form asp-action="Index" method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label asp-for="OgrenciAd" class="form-label"></label>
            <input asp-for="OgrenciAd" class="form-control" placeholder="Adınızı giriniz" />
            <span asp-validation-for="OgrenciAd" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GunSayisi" class="form-label"></label>
            <input asp-for="GunSayisi" type="number" class="form-control" />
            <span asp-validation-for="GunSayisi" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TamamlananKonu" class="form-label"></label>
            <input asp-for="TamamlananKonu" class="form-control" placeholder="Örn: Data Annotations Validation" />
            <span asp-validation-for="TamamlananKonu" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Kaydet ve Gönder</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}